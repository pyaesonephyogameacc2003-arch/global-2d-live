<script>
let pollTimer=null;
let clockTimer=null;
let freeze=null;

function el(id){return document.getElementById(id);}

function saveFreeze(twod,time){
  if(!twod||!time)return;
  freeze={twod:String(twod),time:String(time)};
  localStorage.setItem('twodFreeze',JSON.stringify(freeze));
}

function readFreeze(){
  try{
    let x=JSON.parse(localStorage.getItem('twodFreeze')||'null');
    if(x&&x.twod&&x.time)return x;
  }catch(e){}
  localStorage.removeItem('twodFreeze');
  return null;
}

function showFreeze(x){
  if(!x)return false;
  if(el('twod'))el('twod').textContent=x.twod;
  if(el('time'))el('time').textContent=x.time+' ✓✓';
  if(el('twod'))el('twod').classList.remove('blink');
  return true;
}

async function loadLive(){
  try{
    let response=await fetch('/api/live?t='+Date.now(),{cache:'no-store'});
    if(!response.ok)throw new Error('API '+response.status);
    let d=await response.json();
    let l=d.live||{},r=d.result||[],b=d.bm2d||[];
    let now=new Date();
    let today=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');
    let minutes=now.getHours()*60+now.getMinutes()+now.getSeconds()/60;

    if(el('set'))el('set').textContent=l.set||'--';
    if(el('value'))el('value').textContent=l.value||'--';

    function bm(t,k){
      let x=b.find(a=>a.time===t);
      return x?x[k]||'--':'--';
    }

    if(el('modern0930'))el('modern0930').textContent=bm('09:30 AM','modern');
    if(el('internet0930'))el('internet0930').textContent=bm('09:30 AM','internet');
    if(el('modern1400'))el('modern1400').textContent=bm('02:00 PM','modern');
    if(el('internet1400'))el('internet1400').textContent=bm('02:00 PM','internet');

    let x0930=b.find(a=>a.time==='09:30 AM');
    let x1400=b.find(a=>a.time==='02:00 PM');
    if(el('date0930'))el('date0930').textContent=x0930?' ('+x0930.date+')':'';
    if(el('date0930i'))el('date0930i').textContent=x0930?' ('+x0930.date+')':'';
    if(el('date1400'))el('date1400').textContent=x1400?' ('+x1400.date+')':'';
    if(el('date1400i'))el('date1400i').textContent=x1400?' ('+x1400.date+')':'';

    let result12=null,result1630=null;

    for(let a of r){
      let ot=(a.open_time||'').slice(0,5);
      let dt=a.stock_datetime||'';
      if(!a.twod||a.twod==='--'||!dt||dt.slice(0,10)!==today)continue;
      if(ot==='12:01')result12=a;
      if(ot==='16:30')result1630=a;
    }

    if(minutes>=990 && result1630){
      saveFreeze(result1630.twod,result1630.stock_datetime);
      freeze=readFreeze();
    }

    if(minutes<540){
      let f=readFreeze();
      if(f){
        freeze=f;
        showFreeze(f);
      }else if(result1630){
        saveFreeze(result1630.twod,result1630.stock_datetime);
        freeze=readFreeze();
        showFreeze(freeze);
      }
    }else if(minutes>=540 && minutes<990){
      localStorage.removeItem('twodFreeze');
      freeze=null;
    }

    let confirmed=null;

    if(result1630&&minutes>=990){
      confirmed=result1630;
    }else if(result12){
      let stamp=new Date(result12.stock_datetime.replace(' ','T'));
      let age=(now-stamp)/60000;
      if(age>=0&&age<15)confirmed=result12;
    }

    let twodValue=confirmed?confirmed.twod:(l.twod||'--');
    if(el('twod'))el('twod').textContent=twodValue;

    if(confirmed){
      if(el('time'))el('time').textContent=confirmed.stock_datetime+' ✓✓';
      el('twod').classList.remove('blink');
    }else{
      if(el('time'))el('time').textContent=l.time||'--';
      if(l.twod&&l.twod!=='--')el('twod').classList.add('blink');
    }

    function get(t){
      let x=r.find(a=>(a.open_time||'').slice(0,5)===t.slice(0,5));
      return x?x.twod:'--';
    }

    if(el('r1100'))el('r1100').textContent=get('11:00:00');
    if(el('r1201'))el('r1201').textContent=get('12:01:00');
    if(el('r1500'))el('r1500').textContent=get('15:00:00');
    if(el('r1630'))el('r1630').textContent=get('16:30:00');

  }catch(e){
    console.log('LIVE ERROR',e);

    let f=readFreeze();

    if(f&&new Date().getHours()*60+new Date().getMinutes()>=990)showFreeze(f);

  }

}

function startPolling(){

  if(pollTimer)return;

  loadLive();

  pollTimer=setInterval(loadLive,2000);

}

function stopPolling(){

  if(pollTimer){

    clearInterval(pollTimer);

    pollTimer=null;

  }

}

function runSchedule(){

  let n=new Date();

  let m=n.getHours()*60+n.getMinutes()+n.getSeconds()/60;

  if(m>=540&&m<990){

    localStorage.removeItem('twodFreeze');

    freeze=null;

    startPolling();

    return;

  }

  if(m>=990){

    startPolling();

    return;

  }

  stopPolling();

  let f=readFreeze();

  if(f){

    freeze=f;

    showFreeze(f);

  }else{

    loadLive();

  }

}

runSchedule();

clockTimer=setInterval(runSchedule,1000);

document.addEventListener('visibilitychange',()=>{

  if(document.visibilityState==='visible')runSchedule();

});

window.addEventListener('focus',runSchedule);

window.addEventListener('pageshow',runSchedule);

</script>

